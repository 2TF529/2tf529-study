# ── Cloudflare R2 credentials ─────────────────────────────────────────────────
# Copy file này thành .env và điền thông tin thật
# File .env đã được thêm vào .gitignore — KHÔNG commit file .env thật lên Git

# Lấy Account ID tại: dash.cloudflare.com → bên phải trang chủ → "Account ID"
R2_ACCOUNT_ID=your-cloudflare-account-id

# Lấy R2 API Token tại: dash.cloudflare.com → R2 → Manage R2 API Tokens
# → Create API Token → quyền: Object Read & Write → chọn bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key

# Tên bucket R2 bạn đã tạo (ví dụ: 2tf529-assets)
R2_BUCKET_NAME=2tf529-assets

# Public URL của bucket R2 (sau khi bật Public Access):
# Dạng mặc định: https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
# Hoặc custom domain: https://assets.2tf529.com
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
