---
import BaseLayout from '../layouts/BaseLayout.astro';
const v = '20260821-2';
---

<BaseLayout
  title="Lịch sử làm bài — 2TF529"
  description="Xem lại lịch sử các bài thi đã làm, điểm số, số câu đúng/sai."
  noindex={true}
  pageScripts={[`/js/history.js?v=${v}`]}
  activeNav="lich-su"
>
  <slot slot="header-title"><h1>Giao diện thi trên máy tính</h1></slot>
  <slot slot="header-badge"><div class="badge">LỊCH SỬ LÀM BÀI</div></slot>

  <div class="container">
    <div class="page-title">Lịch sử làm bài</div>

    <!-- Supabase Auth & Cloud Sync Card -->
    <div id="auth-box" style="background:var(--card-bg, #fff);border:1px solid var(--border-color, #e5e7eb);border-radius:12px;padding:16px 20px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
      <div id="auth-logged-out" style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:24px;">☁️</span>
        <div>
          <div style="font-weight:600;font-size:14px;">Đồng bộ lịch sử lên Cloud (Supabase)</div>
          <div style="font-size:12px;color:var(--ink-500, #6b7280);">Đăng nhập Google để lưu điểm và xem lại trên mọi thiết bị</div>
        </div>
      </div>
      <button id="auth-login-btn" class="btn" style="display:inline-flex;align-items:center;gap:8px;font-size:13px;padding:8px 16px;background:#fff;color:#374151;border:1px solid #d1d5db;box-shadow:0 1px 2px rgba(0,0,0,0.05);cursor:pointer;border-radius:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
        <span>Đăng nhập với Google</span>
      </button>

      <div id="auth-logged-in" style="display:none;align-items:center;justify-content:space-between;width:100%;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <img id="auth-user-avatar" style="width:36px;height:36px;border-radius:50%;border:2px solid var(--primary, #1a56db);display:none;" src="" alt="Avatar">
          <div>
            <div id="auth-user-name" style="font-weight:600;font-size:14px;"></div>
            <div style="font-size:11px;color:var(--green-600, #16a34a);display:flex;align-items:center;gap:4px;">
              <span>●</span> Đã kết nối Supabase Cloud Sync
            </div>
          </div>
        </div>
        <button id="auth-logout-btn" class="btn secondary" style="font-size:12px;padding:6px 12px;">Đăng xuất</button>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
      <div class="result-count" id="history-count"></div>
      <button class="btn secondary" id="clear-btn" style="font-size:12px;padding:6px 14px;">Xoá lịch sử</button>
    </div>

    <div class="exam-list" id="history-list"></div>
  </div>
</BaseLayout>
