---
import BaseLayout from '../layouts/BaseLayout.astro';
const v = '20260821-2';
---

<BaseLayout
  title="Tìm đề thi — 2TF529"
  description="Tìm và lọc 9.600+ đề thi theo khối lớp, môn học, loại kỳ thi. Có đáp án chuẩn chính thức."
  canonical="https://2tf529.id.vn/explore.html"
  ogTitle="Tìm đề thi — 2TF529"
  ogDesc="9.600+ đề thi miễn phí, lọc theo khối, môn, loại kỳ thi. Đáp án chuẩn chính thức."
  preloadFetch={['/data/chunks/explore-l12.json']}
  pageScripts={[`/js/explore.js?v=${v}`]}
  activeNav="explore"
>
  <slot slot="header-title"><h1>Giao diện thi trên máy tính</h1></slot>
  <slot slot="header-badge"><div class="badge">TÌM ĐỀ THI</div></slot>

  <div class="container">
    <div class="page-title">Tìm đề thi</div>

    <div class="filter-bar">
      <select id="f-grade"><option value="">-- Khối lớp --</option></select>
      <select id="f-subject"><option value="">-- Môn học --</option></select>
      <select id="f-type"><option value="">-- Loại kỳ thi --</option></select>
      <select id="f-answer">
        <option value="">-- Trạng thái đáp án --</option>
        <option value="official">🎯 Đáp án chuẩn chính thức</option>
        <option value="ai">🤖 Đáp án do AI giải</option>
        <option value="has_answer">✅ Đã có đáp án (Chuẩn + AI)</option>
        <option value="missing">⏳ Đang cập nhật đáp án</option>
      </select>
      <input id="f-keyword" type="text" placeholder="Tìm theo tên đề...">
      <select id="f-sort">
        <option value="priority">🎯 Ưu tiên đáp án chuẩn</option>
        <option value="newest">Mới nhất</option>
        <option value="oldest">Cũ nhất</option>
        <option value="name">Tên A-Z</option>
      </select>
    </div>

    <div class="result-count" id="result-count"></div>
    <div class="exam-list" id="exam-list">
      <div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div>
    </div>
  </div>
</BaseLayout>
