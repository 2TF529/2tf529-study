---
// dashboard.astro — Trang dashboard sau khi đăng nhập
const v = '20260825-27';
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dashboard — 2TF529</title>
  <meta name="robots" content="noindex,nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script is:inline>
    (function(){
      var d = document.documentElement;
      d.setAttribute('data-theme', localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
    })();
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    [hidden] { display: none !important; }

    :root {
      --sb-w: 240px;
      --bg: #0b0f1a;
      --surface: #111827;
      --surface2: #1a2235;
      --border: rgba(255,255,255,.07);
      --text: #f0ece4;
      --text2: #8b8fa8;
      --accent: #4f8ef7;
      --accent2: #f5c842;
      --green: #22c55e;
      --red: #ef4444;
      --amber: #f59e0b;
      --r: 14px;
      --shadow: 0 4px 24px rgba(0,0,0,.35);
    }

    html[data-theme="light"] {
      --bg: #f4f7fb;
      --surface: #ffffff;
      --surface2: #eef3f9;
      --border: #dbe3ef;
      --text: #162033;
      --text2: #667085;
      --accent: #2563eb;
      --accent2: #d79a12;
      --green: #059669;
      --red: #dc2626;
      --amber: #d97706;
      --shadow: 0 10px 30px rgba(30,64,175,.10);
      color-scheme: light;
    }

    body { font-family: 'Inter',sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; overflow-x: hidden; }

    /* ===== SIDEBAR ===== */
    .sidebar {
      width: var(--sb-w); flex-shrink: 0;
      background: var(--surface); border-right: 1px solid var(--border);
      display: flex; flex-direction: column;
      position: fixed; top: 0; left: 0; bottom: 0; z-index: 100;
      transition: transform .3s cubic-bezier(.4,0,.2,1);
    }
    .sb-logo { padding: 20px 20px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .sb-logo-mark { width: 36px; height: 36px; background: linear-gradient(135deg,#3a6ab8,#4f8ef7); border-radius: 10px; display: grid; place-items: center; font-weight: 900; font-size: 13px; color: #fff; letter-spacing: -.5px; box-shadow: 0 4px 12px rgba(79,142,247,.35); flex-shrink: 0; }
    .sb-logo b { display: block; font-size: 14px; font-weight: 800; color: var(--text); }
    .sb-logo small { font-size: 11px; color: var(--text2); }
    .sb-user { padding: 14px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
    .sb-avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg,#3a6ab8,#4f8ef7); display: grid; place-items: center; font-weight: 800; font-size: 14px; color: #fff; flex-shrink: 0; overflow: hidden; position: relative; }
    .sb-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
    .sb-uname { font-size: 13.5px; font-weight: 700; color: var(--text); }
    .sb-usub { font-size: 11.5px; color: var(--text2); margin-top: 1px; }
    .sb-nav { flex: 1; overflow-y: auto; padding: 12px 10px; display: flex; flex-direction: column; gap: 2px; }
    .sb-section { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text2); padding: 10px 10px 4px; }
    .sb-link { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 10px; text-decoration: none; color: var(--text2); font-size: 13.5px; font-weight: 600; transition: background .15s, color .15s; }
    .sb-link:hover { background: var(--surface2); color: var(--text); }
    .sb-link.active { background: rgba(79,142,247,.15); color: var(--accent); }
    .sb-link .ni { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }
    .sb-bottom { padding: 12px 10px; border-top: 1px solid var(--border); }
    .sb-logout { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 10px; background: transparent; border: none; color: #f87171; font-size: 13.5px; font-weight: 600; cursor: pointer; width: 100%; transition: background .15s; font-family: 'Inter',sans-serif; }
    .sb-logout:hover { background: rgba(239,68,68,.1); }

    /* ===== MAIN ===== */
    .main { margin-left: var(--sb-w); flex: 1; min-width: 0; }
    .topbar { background: rgba(11,15,26,.9); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); padding: 0 28px; height: 60px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
    html[data-theme="light"] .topbar { background:rgba(255,255,255,.9); }
    html[data-theme="light"] .sidebar { box-shadow:8px 0 30px rgba(30,64,175,.05); }
    .topbar-l { display: flex; align-items: center; gap: 12px; }
    .topbar-title { font-size: 16px; font-weight: 800; color: var(--text); }
    .topbar-sub { font-size: 12px; color: var(--text2); }
    .topbar-r { display: flex; align-items: center; gap: 10px; }
    .topbar-btn { width: 36px; height: 36px; border-radius: 10px; background: var(--surface2); border: 1px solid var(--border); color: var(--text2); font-size: 16px; cursor: pointer; display: grid; place-items: center; transition: background .15s, color .15s; }
    .topbar-btn:hover { background: var(--surface); color: var(--text); }
    .topbar-profile { padding: 7px 16px; background: rgba(79,142,247,.15); border: 1px solid rgba(79,142,247,.25); border-radius: 10px; color: var(--accent); font-size: 13px; font-weight: 700; text-decoration: none; transition: background .15s; }
    .topbar-profile:hover { background: rgba(79,142,247,.25); }
    .hbtn { display: none; width: 36px; height: 36px; background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; color: var(--text2); font-size: 16px; cursor: pointer; }

    .content { padding: 28px; }

    /* Welcome hero */
    .hero {
      border-radius: 20px; padding: 32px 36px;
      background: linear-gradient(135deg,#0f2040 0%,#1a3a60 50%,#0f2040 100%);
      position: relative; overflow: hidden;
      margin-bottom: 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      animation: fadeUp .5s ease both;
    }
    .hero::before { content:''; position:absolute; top:-40%; right:-10%; width:420px; height:420px; background:radial-gradient(circle,rgba(79,142,247,.18) 0%,transparent 70%); pointer-events:none; }
    .hero::after { content:''; position:absolute; bottom:-30%; left:20%; width:300px; height:300px; background:radial-gradient(circle,rgba(245,200,66,.08) 0%,transparent 70%); pointer-events:none; }
    @keyframes fadeUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
    .hero-text { position:relative; z-index:1; }
    .hero-greet { font-size:13px; color:rgba(255,255,255,.45); letter-spacing:.5px; text-transform:uppercase; margin-bottom:6px; }
    .hero-name { font-size:28px; font-weight:900; color:#fff; line-height:1.1; margin-bottom:8px; }
    .hero-goal { font-size:14px; color:rgba(255,255,255,.55); display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .goal-chip { background:rgba(245,200,66,.15); border:1px solid rgba(245,200,66,.3); color:#f5c842; padding:3px 12px; border-radius:50px; font-size:12.5px; font-weight:700; }
    .hero-streak { position:relative; z-index:1; text-align:center; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:20px 28px; backdrop-filter:blur(8px); flex-shrink:0; }
    .streak-fire { font-size:32px; margin-bottom:4px; }
    .streak-num { font-size:36px; font-weight:900; color:#f5c842; line-height:1; }
    .streak-lbl { font-size:12px; color:rgba(255,255,255,.5); margin-top:4px; }

    /* Stats */
    .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; animation:fadeUp .5s .05s ease both; }
    .stat { background:var(--surface); border:1px solid var(--border); border-radius:var(--r); padding:20px; display:flex; flex-direction:column; gap:8px; transition:transform .2s,box-shadow .2s,border-color .2s; cursor:default; }
    .stat:hover { transform:translateY(-3px); box-shadow:var(--shadow); border-color:rgba(79,142,247,.2); }
    .stat-hd { display:flex; align-items:center; justify-content:space-between; }
    .stat-lbl { font-size:12px; font-weight:700; color:var(--text2); text-transform:uppercase; letter-spacing:.5px; }
    .stat-ico { font-size:18px; }
    .stat-val { font-size:36px; font-weight:900; color:var(--text); line-height:1; }
    .stat-sub { font-size:12px; color:var(--text2); }
    .stat.blue .stat-val { color:var(--accent); }
    .stat.green .stat-val { color:var(--green); }
    .stat.amber .stat-val { color:var(--amber); }
    .random-study-stat { text-align:left; font-family:inherit; cursor:pointer; position:relative; overflow:hidden; color:#fff; border-color:transparent; background:linear-gradient(135deg,#2563eb 0%,#7c3aed 62%,#db2777 130%); box-shadow:0 10px 28px rgba(79,70,229,.24); }
    .random-study-stat::after { content:'🎲'; position:absolute; right:-5px; bottom:-17px; font-size:78px; opacity:.11; transform:rotate(-12deg); }
    .random-study-stat .stat-lbl,.random-study-stat .stat-sub { color:rgba(255,255,255,.76); }
    .random-study-stat .stat-val { color:#fff; font-size:18px; line-height:1.3; }
    .random-study-stat:hover { border-color:rgba(255,255,255,.38); box-shadow:0 14px 34px rgba(79,70,229,.34); }
    .random-study-stat:disabled { opacity:.7; cursor:wait; }

    /* Section title */
    .stitle { font-size:15px; font-weight:800; color:var(--text); margin-bottom:14px; display:flex; align-items:center; gap:8px; }
    .stitle::after { content:''; flex:1; height:1px; background:var(--border); }

    /* Quick cards */
    .qgrid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:28px; animation:fadeUp .5s .1s ease both; }
    .qcard { background:var(--surface); border:1px solid var(--border); border-radius:var(--r); padding:20px; text-decoration:none; display:flex; flex-direction:column; gap:10px; transition:transform .2s,box-shadow .2s,border-color .2s; position:relative; overflow:hidden; }
    .qcard::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--qa,var(--accent)); border-radius:3px 3px 0 0; opacity:0; transition:opacity .2s; }
    .qcard:hover { transform:translateY(-4px); box-shadow:var(--shadow); border-color:rgba(79,142,247,.2); }
    .qcard:hover::before { opacity:1; }
    .qcard-ico { font-size:28px; }
    .qcard-title { font-size:14.5px; font-weight:800; color:var(--text); }
    .qcard-desc { font-size:12.5px; color:var(--text2); line-height:1.5; }
    .qcard-arrow { margin-top:auto; font-size:12px; color:var(--accent); font-weight:700; }

    /* Dashboard grid */
    .dgrid { display:grid; grid-template-columns:1fr 360px; gap:20px; animation:fadeUp .5s .15s ease both; }
    .panel { background:var(--surface); border:1px solid var(--border); border-radius:var(--r); overflow:hidden; }
    .panel-hd { padding:18px 20px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
    .panel-hd-t { font-size:15px; font-weight:800; color:var(--text); }
    .panel-hd-a { font-size:12.5px; color:var(--accent); text-decoration:none; font-weight:700; }
    .panel-hd-a:hover { text-decoration:underline; }
    .panel-body { padding:8px; }

    /* History rows */
    #dash-hist :global(.hrow) { display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border-radius:10px; text-decoration:none; gap:12px; transition:background .15s; }
    #dash-hist :global(.hrow:hover) { background:var(--surface2); }
    #dash-hist :global(.hrow-t) { font-size:13.5px; font-weight:700; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:300px; }
    #dash-hist :global(.hrow-d) { font-size:11.5px; color:var(--text2); margin-top:2px; }
    #dash-hist :global(.hscore) { font-size:20px; font-weight:900; flex-shrink:0; min-width:48px; text-align:right; }
    #dash-hist :global(.hscore.g) { color:var(--green); }
    #dash-hist :global(.hscore.o) { color:var(--amber); }
    #dash-hist :global(.hscore.b) { color:var(--red); }
    #dash-hist :global(.hscore.d) { color:var(--text2); font-size:12px; font-weight:600; }

    #dash-hist :global(.pempty) { padding:40px 20px; text-align:center; color:var(--text2); font-size:13.5px; line-height:1.8; }
    #dash-hist :global(.pempty a) { color:var(--accent); font-weight:700; text-decoration:none; }

    /* Monthly study calendar */
    .calendar-wrap { padding:18px; }
    .calendar-shell { display:grid; grid-template-columns:minmax(0,1fr) 210px; gap:14px; align-items:stretch; }
    .calendar-main { min-width:0; padding:16px; border:1px solid var(--border); border-radius:16px; background:var(--surface); }
    .calendar-nav { display:flex; align-items:center; gap:8px; }
    .calendar-nav button { width:32px; height:32px; border:1px solid var(--border); border-radius:50%; background:var(--surface2); color:var(--text); cursor:pointer; font-size:20px; line-height:1; }
    .calendar-nav button:hover { background:var(--accent); color:#fff; }
    .calendar-nav span { min-width:108px; text-align:center; color:var(--text); font-size:13px; font-weight:800; text-transform:capitalize; }
    .month-calendar { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0; }
    .month-calendar :global(.calendar-month-block) { min-width:0; padding:2px 18px 8px; }
    .month-calendar :global(.calendar-month-block + .calendar-month-block) { border-left:1px solid var(--border); }
    .month-calendar :global(.calendar-month-title) { margin:0 0 14px; text-align:center; color:var(--text); font-size:14px; font-weight:800; text-transform:capitalize; }
    .month-calendar :global(.calendar-weekdays), .month-calendar :global(.calendar-grid) { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:5px 3px; }
    .month-calendar :global(.calendar-weekdays) { margin-bottom:5px; }
    .month-calendar :global(.calendar-weekdays span) { padding:5px 0; text-align:center; color:var(--text2); font-size:10px; font-weight:800; text-transform:uppercase; }
    .month-calendar :global(.cal-day) { width:36px; height:36px; justify-self:center; border:0; background:transparent; border-radius:50%; padding:0; color:var(--text); position:relative; display:grid; place-items:center; cursor:pointer; font-family:inherit; transition:background .16s,color .16s,transform .16s,box-shadow .16s; }
    .month-calendar :global(.cal-day:hover:not(.empty)) { transform:scale(1.08); background:var(--surface2); }
    .month-calendar :global(.cal-day.empty) { cursor:default; opacity:0; pointer-events:none; }
    .month-calendar :global(.cal-num) { display:grid; place-items:center; font-size:12px; font-weight:700; line-height:1; }
    .month-calendar :global(.cal-day.active) { background:color-mix(in srgb,var(--accent) 14%,var(--surface)); color:var(--accent); }
    .month-calendar :global(.cal-day.selected) { background:var(--text); color:var(--surface); box-shadow:0 7px 18px color-mix(in srgb,var(--text) 24%,transparent); }
    .month-calendar :global(.cal-day.today:not(.selected)) { box-shadow:inset 0 0 0 2px var(--accent); color:var(--accent); }
    .month-calendar :global(.cal-count) { position:absolute; right:-1px; top:-1px; min-width:14px; height:14px; padding:0 3px; display:grid; place-items:center; border-radius:999px; background:var(--accent); color:#fff; font-size:7px; font-weight:900; }
    .cal-note { margin-top:12px; color:var(--text2); font-size:11.5px; display:flex; align-items:center; gap:7px; }
    .cal-note::before { content:''; width:9px; height:9px; border-radius:3px; background:var(--accent); }
    .calendar-agenda { min-width:0; padding:16px; border:1px solid var(--border); border-radius:16px; background:linear-gradient(155deg,color-mix(in srgb,var(--accent) 8%,var(--surface)),var(--surface)); }
    .agenda-title { color:var(--text); font-size:13px; font-weight:850; margin:0 0 12px; padding-bottom:11px; border-bottom:1px solid var(--border); }
    .agenda-list { display:flex; flex-direction:column; gap:9px; }
    .agenda-list :global(.agenda-item) { border:1px solid var(--border); background:var(--surface); border-radius:11px; padding:11px; }
    .agenda-list :global(.agenda-item b) { display:block; color:var(--text); font-size:11.5px; line-height:1.35; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .agenda-list :global(.agenda-item span) { display:block; color:var(--accent); font-size:10px; font-weight:800; margin-top:4px; }
    .agenda-list :global(.agenda-empty) { color:var(--text2); font-size:12px; line-height:1.55; padding:6px 0; }

    /* Leaderboards */
    .honor { margin-top:28px; animation:fadeUp .5s .2s ease both; }
    .leader-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
    .leader-card { background:var(--surface); border:1px solid var(--border); border-top:3px solid var(--leader,var(--accent)); border-radius:var(--r); padding:18px; min-height:190px; }
    .leader-title { font-size:12.5px; font-weight:900; text-transform:uppercase; color:var(--text); display:flex; align-items:center; gap:7px; }
    .leader-list { margin-top:15px; display:flex; flex-direction:column; gap:8px; }
    .leader-list :global(.leader-row) { display:grid; grid-template-columns:28px 34px minmax(0,1fr) auto; gap:9px; align-items:center; padding:7px 0; }
    .leader-list :global(.leader-rank) { width:25px; height:25px; display:grid; place-items:center; border-radius:50%; background:var(--surface2); color:var(--text2); font-size:11px; font-weight:900; }
    .leader-list :global(.leader-row:first-child .leader-rank) { background:#fbbf24; color:#5b3700; }
    .leader-list :global(.leader-row:nth-child(2) .leader-rank) { background:#cbd5e1; color:#334155; }
    .leader-list :global(.leader-row:nth-child(3) .leader-rank) { background:#d97706; color:#fff7ed; }
    .leader-list :global(.leader-row.is-me) { margin-inline:-8px; padding-inline:8px; border-radius:10px; background:color-mix(in srgb,var(--leader,var(--accent)) 8%,transparent); }
    .leader-list :global(.leader-avatar) { width:32px; height:32px; display:grid; place-items:center; border-radius:50%; color:#fff; background:linear-gradient(135deg,#2563eb,#7c3aed); font-size:11px; font-weight:900; overflow:hidden; }
    .leader-list :global(.leader-avatar img) { width:100%; height:100%; object-fit:cover; }
    .leader-list :global(.leader-name) { min-width:0; color:var(--text); font-size:12.5px; font-weight:750; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .leader-list :global(.leader-value) { color:var(--leader,var(--accent)); font-size:12px; font-weight:900; white-space:nowrap; }
    .leader-list :global(.leader-empty) { color:var(--text2); font-size:12.5px; line-height:1.65; padding:20px 4px 4px; }

    /* System stats */
    .sys-stat b { font-size:22px; color:var(--text); }

    /* Toast */
    .toast { position:fixed; top:16px; left:50%; transform:translateX(-50%) translateY(-80px); z-index:999; padding:12px 24px; border-radius:12px; font-size:14px; font-weight:700; transition:transform .35s cubic-bezier(.34,1.56,.64,1); pointer-events:none; }
    .toast.s { background:rgba(34,197,94,.92); color:#fff; }
    .toast.e { background:rgba(239,68,68,.92); color:#fff; }
    .toast.show { transform:translateX(-50%) translateY(0); }

    /* Profile editor */
    .profile-modal { position:fixed; inset:0; z-index:1200; display:grid; place-items:center; padding:20px; }
    .profile-modal[hidden] { display:none; }
    .profile-backdrop { position:absolute; inset:0; border:0; background:rgba(2,6,23,.7); backdrop-filter:blur(8px); cursor:default; }
    .profile-dialog { position:relative; width:min(760px,100%); max-height:min(860px,92vh); overflow:auto; border:1px solid var(--border); border-radius:22px; background:var(--surface); color:var(--text); box-shadow:0 30px 90px rgba(0,0,0,.4); }
    .profile-dialog-hd { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:20px 22px; border-bottom:1px solid var(--border); }
    .profile-dialog-hd h2 { margin:0; font-size:20px; }
    .profile-close { width:36px; height:36px; border:1px solid var(--border); border-radius:50%; background:var(--surface2); color:var(--text); font-size:20px; cursor:pointer; }
    .profile-form { padding:22px; }
    .profile-fields { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .profile-fields label { display:flex; flex-direction:column; gap:7px; color:var(--text2); font-size:12px; font-weight:800; }
    .profile-fields label.wide { grid-column:1/-1; }
    .profile-fields input[type="text"] { width:100%; min-height:45px; padding:10px 13px; border:1px solid var(--border); border-radius:11px; background:var(--surface2); color:var(--text); outline:none; }
    .profile-fields input[type="text"]:focus { border-color:var(--accent); box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 14%,transparent); }
    .profile-images { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:20px; }
    .profile-image-pick { position:relative; min-height:132px; overflow:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; border:1px dashed var(--border); border-radius:14px; background:var(--surface2); color:var(--text2); cursor:pointer; text-align:center; font-size:12px; font-weight:800; }
    .profile-image-pick img { width:64px; height:64px; border-radius:14px; object-fit:cover; background:var(--surface); }
    .profile-image-pick.cover img { width:112px; }
    .profile-image-pick input { position:absolute; width:1px; height:1px; opacity:0; }
    .profile-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:20px; }
    .profile-actions button { min-height:43px; padding:0 18px; border-radius:11px; border:1px solid var(--border); background:var(--surface2); color:var(--text); font-weight:850; cursor:pointer; }
    .profile-actions .save { border-color:var(--accent); background:var(--accent); color:#fff; }

    /* Loading */
    .loader { position:fixed; inset:0; background:var(--bg); display:grid; place-items:center; z-index:999; transition:opacity .4s; }
    .loader.gone { opacity:0; pointer-events:none; }
    .spinner { width:44px; height:44px; border:3px solid var(--surface2); border-top-color:var(--accent); border-radius:50%; animation:spin .8s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* Sidebar overlay */
    .sb-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:90; opacity:0; pointer-events:none; transition:opacity .3s; }

    /* Responsive */
    @media(max-width:1100px) { .qgrid { grid-template-columns:repeat(2,1fr); } .dgrid { grid-template-columns:1fr; } .leader-grid { grid-template-columns:1fr 1fr; } }
    @media(max-width:900px) {
      .sidebar { transform:translateX(-100%); }
      .sidebar.open { transform:translateX(0); }
      .sb-overlay { display:block; }
      .sb-overlay.open { opacity:1; pointer-events:auto; }
      .main { margin-left:0; }
      .hbtn { display:grid; place-items:center; }
      .stats { grid-template-columns:repeat(2,1fr); }
    }
    @media(max-width:760px) { .calendar-shell { grid-template-columns:1fr; } .calendar-main { padding:12px; } .calendar-agenda { padding:14px; } .month-calendar { grid-template-columns:1fr; } .month-calendar :global(.calendar-month-block) { padding:2px 6px 8px; } .month-calendar :global(.calendar-month-block:nth-child(2)) { display:none; } }
    @media(max-width:650px) { .calendar-wrap { padding:10px; } .month-calendar :global(.calendar-grid) { gap:3px 1px; } .month-calendar :global(.cal-day) { width:32px; height:32px; } .month-calendar :global(.cal-num) { font-size:11px; } .month-calendar :global(.cal-count) { min-width:13px; height:13px; font-size:7px; } .leader-grid { grid-template-columns:1fr; } }
    @media(max-width:540px) { .content { padding:16px; } .hero { padding:24px; flex-direction:column; } .qgrid { grid-template-columns:1fr; } .topbar { padding:0 16px; } }
  </style>
</head>
