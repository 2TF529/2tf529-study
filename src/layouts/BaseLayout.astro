---
// BaseLayout.astro — Layout dùng chung cho tất cả pages
// Props: title, description, canonical, noindex, ogTitle, ogDesc
// Scripts: pageScripts (mảng src), earlyScripts (mảng src, load sớm trước security)
// Preloads: preloadFetch (array of URLs để preload as fetch)

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDesc?: string;
  preloadFetch?: string[];
  pageScripts?: string[];
  activeNav?: 'home' | 'explore' | 'on-tap' | 'lich-su' | 'ung-ho';
}

const {
  title,
  description = 'Web thi thử miễn phí: Tốt nghiệp THPT, đề khối 10-11-12, tuyển sinh lớp 10. 9.600+ đề thi chuẩn, có đáp án.',
  canonical,
  noindex = false,
  ogTitle,
  ogDesc,
  preloadFetch = [],
  pageScripts = [],
  activeNav,
} = Astro.props;

const v = '20260821-2'; // version bust cho CSS/JS
---

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{noindex
  ? <meta name="robots" content="noindex, nofollow">
  : <meta name="robots" content="index, follow">
}
{canonical && <link rel="canonical" href={canonical}>}
{(ogTitle || title) && <meta property="og:title" content={ogTitle || title}>}
{(ogDesc || description) && <meta property="og:description" content={ogDesc || description}>}
{(ogTitle || title) && <meta property="og:type" content="website">}
<meta name="theme-color" content="#1a56db">

<!-- Khởi tạo theme đồng bộ (chống flash) -->
<script is:inline>
  (function(){
    var d = document.documentElement;
    d.setAttribute('data-theme', localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
    d.setAttribute('data-palette', localStorage.getItem('palette') || '9');
  })();
</script>

<!-- Preload CSS + theme.js -->
<link rel="preload" href={`/css/style.css?v=${v}`} as="style">
<link rel="preload" href={`/js/theme.js?v=${v}`} as="script">

<!-- Preload data JSONs cần thiết cho trang này -->
{preloadFetch.map(url => (
  <link rel="preload" href={url} as="fetch" crossorigin="anonymous">
))}

<!-- DNS prefetch cho external -->
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
<link rel="dns-prefetch" href="https://translate.googleapis.com">

<link rel="stylesheet" href={`/css/style.css?v=${v}`}>

<!-- Slot cho head extras (KaTeX, MathJax config, v.v.) -->
<slot name="head" />
</head>
<body>

<header class="site-header">
  <slot name="header-title">
    <h1>WEBSITE THI THỬ</h1>
  </slot>
  <slot name="header-badge">
    <div class="badge">2TF SCHOOL <br>2TF 529</div>
  </slot>
</header>

<nav class="top-nav">
  <button class="hamburger" id="hamburger-btn" aria-label="Menu">☰</button>
  <div class="nav-links">
    <a href="/index.html" class={`nav-link${activeNav === 'home' ? ' active' : ''}`}>Trang chủ</a>
    <a href="/explore.html" class={`nav-link${activeNav === 'explore' ? ' active' : ''}`}>Tìm đề thi</a>
    <a href="/on-tap.html" class={`nav-link${activeNav === 'on-tap' ? ' active' : ''}`}>Ôn theo dạng</a>
    <a href="/lich-su.html" class={`nav-link${activeNav === 'lich-su' ? ' active' : ''}`}>Lịch sử</a>
    <a href="/ung-ho.html" class={`nav-link${activeNav === 'ung-ho' ? ' active' : ''}`}>Ủng hộ</a>
  </div>
  <div class="nav-controls">
    <select id="palette-select" class="palette-select" aria-label="Chọn tông màu">
      <option value="1">🔵 Xanh dương - be ấm</option>
      <option value="2">🟢 Xanh lá - cam đất</option>
      <option value="3">🟣 Tím - hồng pastel</option>
      <option value="4">🔷 Navy dịu + màu môn học</option>
      <option value="5">🌊 Đại dương cyan</option>
      <option value="6">🌸 Hoa anh đào</option>
      <option value="7">🔥 Lửa ấm</option>
      <option value="8">🌿 Rừng xanh</option>
      <option value="9">🖤 Monochrome</option>
      <option value="10">☕ Cà phê vintage</option>
    </select>
    <button class="theme-toggle" id="theme-toggle" aria-label="Chuyển giao diện">🌙</button>
  </div>
</nav>

<!-- Content chính của từng trang -->
<slot />

<!-- Security: load sớm, không defer -->
<script is:inline src={`/js/security.js?v=${v}`}></script>
<script is:inline src={`/js/shield.js?v=${v}`}></script>

<!-- Core: theme + supabase + sw-register (defer) -->
<script is:inline src={`/js/theme.js?v=${v}`} defer></script>
<script is:inline src={`/js/supabase.js?v=${v}`} defer></script>
<script is:inline src={`/js/sw-register.js?v=${v}`} defer></script>

<!-- Floating tools (defer) -->
<script is:inline src={`/js/calculator.js?v=${v}`} defer></script>
<script is:inline src={`/js/whiteboard.js?v=${v}`} defer></script>
<script is:inline src={`/js/translate.js?v=${v}`} defer></script>

<!-- Page-specific scripts -->
{pageScripts.map(src => (
  <script is:inline src={src} defer></script>
))}

</body>
</html>
