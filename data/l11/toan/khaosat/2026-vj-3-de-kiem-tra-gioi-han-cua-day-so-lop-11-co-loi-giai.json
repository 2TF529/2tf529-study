    {
      "id": 5,
      "type": "single",
      "content": "Câu 5: Tính \\[L = \\lim \\frac{{n - 1}}{{{n^3} + 3}}\\] .",
      "options": [
        "A. \\[L = 1.\\]",
        "B. \\[L = 0.\\]",
        "C. \\[L = 3.\\]",
        "D. \\[L = 2.\\]"
