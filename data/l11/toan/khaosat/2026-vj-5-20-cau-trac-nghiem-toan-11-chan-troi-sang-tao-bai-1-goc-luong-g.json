        "C. (Ou, Ov) − (Ov, Ow) = (Ou, Ow) + \\[k360^\\circ (k \\in \\mathbb{Z})\\] .",
        "D. (Ou, Ov) − (Ow, Ov) = (Ou, Ow) + \\[k360^\\circ (k \\in \\mathbb{Z})\\] ."
