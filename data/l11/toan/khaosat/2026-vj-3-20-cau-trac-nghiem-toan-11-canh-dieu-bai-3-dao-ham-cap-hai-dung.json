    {
      "id": 3,
      "type": "single",
      "content": "Câu 3: Hàm số \\(y = \\frac{x}{{x - 2}}\\) có đạo hàm cấp hai là:",
      "options": [
        "A. y\" = 0.",
        "B. \\(y'' = \\frac{1}{{{{\\left( {x - 2} \\right)}^2}}}\\).",
        "C. \\(y'' = - \\frac{4}{{{{\\left( {x - 2} \\right)}^2}}}\\).",
        "D. \\(y'' = \\frac{4}{{{{\\left( {x - 2} \\right)}^3}}}\\)."
      ],
      "answer": "D",
      "note": "D \\(y' = \\frac{{ - 2}}{{{{\\left( {x - 2} \\right)}^2}}}\\) ; \\(y'' = \\frac{{4\\left( {x - 2} \\right)}}{{{{\\left( {x - 2} \\right)}^4}}} = \\frac{4}{{{{\\left( {x - 2} \\right)}^3}}}\\) ."
    },
